# Environment for the static-analysis pre-commit hooks (mypy, bandit).
#
# Why this file exists: pre-commit has no per-hook env support, so these vars
# used to be inlined via `entry: bash -c "VAR=... uv run ..."`. That breaks on
# Windows, where `bash` resolves to WSL bash — a separate filesystem that cannot
# see the Windows `uv.exe`, so the hook died with `uv: command not found`.
# `uv run --env-file` is shell-free and works identically on Windows and Linux.
#
# django-stubs imports project.settings at load time for the mypy plugin.
# Without DJANGO_DEBUG + a dummy secret key, settings.py's production guard
# raises ValueError and mypy reports "Error constructing plugin instance".
# See CLAUDE.md.
#
# NOTE: the secret key below is a throwaway for static analysis only. It never
# reaches a running process. Real keys live in GCP Secret Manager.
DJANGO_SETTINGS_MODULE=project.settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dummy-secret-key-for-static-analysis
PYTHONPATH=project
PYTHONUTF8=1